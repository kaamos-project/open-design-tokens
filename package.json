{
  "name": "@kaamos-project/open-design-tokens",
  "version": "0.2.0",
  "description": "Kaamos design tokens (W3C DTCG) and shared assets, generated for CSS, Tailwind CSS v4 and Flutter.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaamos-project/open-design-tokens.git"
  },
  "type": "module",
  "files": [
    "dist/css",
    "dist/tailwind",
    "dist/icons",
    "assets/fonts/*.woff2",
    "assets/fonts/OFL.txt"
  ],
  "exports": {
    "./tokens.css": "./dist/css/tokens.css",
    "./fonts.css": "./dist/css/fonts.css",
    "./tailwind.css": "./dist/tailwind/theme.css",
    "./fonts/*": "./assets/fonts/*",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./icons/sprite.svg": "./dist/icons/sprite.svg",
    "./icons/icons.json": "./dist/icons/icons.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node config/build.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "icons:update": "node scripts/update-lucide.mjs"
  },
  "devDependencies": {
    "harfbuzzjs": "1.6.4",
    "lucide-static": "1.83.0",
    "style-dictionary": "5.8.0",
    "subset-font": "2.4.0"
  }
}
